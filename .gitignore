# Big Data files (Keep directory structure via .gitkeep, ignore bulk generated data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Exclude large datasets
*.parquet
*.csv.gz
*.tar.gz
*.zip

# Exception for sample test fixtures
!data/sample/*.csv
!data/sample/*.parquet
